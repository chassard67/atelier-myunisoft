{
  "manifest_version": 3,
  "name": "Atelier MyUnisoft",
  "short_name": "Atelier MU",
  "version": "1.0.0",
  "description": "Personnalisation de l'interface MyUnisoft (Balance, Premium, Consultation…). Les modules se mettent à jour automatiquement.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "userScripts",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://connect.lgassocies.com/*",
    "https://*.myunisoft.fr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://connect.lgassocies.com/*",
        "https://*.myunisoft.fr/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atelier MyUnisoft",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}