{
  "minExtensionVersion": "1.1.0",
  "licenceRequired": true,
  "release": {
    "version": "1.4.0",
    "date": "2026-11-15",
    "notes": [
      "Les modules Premium sont désormais servis par un serveur de licences : le code n'est livré qu'aux clés valides (réinstaller l'extension 1.2.0).",
      "Affichage Premium : le centrage « grand écran » ne s'applique plus qu'au-delà de 2200 px (un portable Full HD 1920 n'est plus centré)."
    ]
  },
  "defaultMatches": [
    "https://connect.lgassocies.com/*",
    "https://*.myunisoft.fr/*"
  ],
  "order": [
    "socle",
    "premium",
    "balance",
    "revision",
    "solde-comptes",
    "grand-livre",
    "consult-premium"
  ],
  "required": [
    "socle",
    "premium",
    "grand-livre"
  ],
  "dependencies": {
    "consult-premium": [
      "grand-livre"
    ]
  },
  "catalog": [
    {
      "group": "Affichage Premium",
      "items": [
        {
          "type": "setting",
          "id": "centerLayout",
          "label": "Centrage du contenu sur grand écran",
          "default": true
        },
        {
          "type": "setting",
          "id": "gridLines",
          "label": "Lignes de séparation dans les tableaux",
          "default": true
        },
        {
          "type": "setting",
          "id": "monoFont",
          "label": "Chiffres en police à chasse fixe (Consolas)",
          "default": true
        },
        {
          "type": "module",
          "id": "revision",
          "label": "Dossier de révision : cycles en pastilles",
          "default": true
        },
        {
          "type": "module",
          "id": "solde-comptes",
          "label": "Solde des comptes dans la recherche de compte",
          "default": true
        },
        {
          "type": "setting",
          "id": "showStatus",
          "label": "Statut MyUnisoft (météo) dans le menu",
          "default": false
        },
        {
          "type": "setting",
          "id": "maximizeConsultWindow",
          "label": "Agrandir les fenêtres popup (consultation, MyU Vision…)",
          "default": true
        }
      ]
    },
    {
      "group": "Fonctionnalités Premium",
      "items": [
        {
          "type": "module",
          "id": "balance",
          "label": "Balance Premium (menu Tenue, sous Balance)",
          "default": true
        },
        {
          "type": "setting",
          "id": "glPremium",
          "label": "Grand Livre Premium (menu Tenue, sous Grand livre)",
          "default": true
        },
        {
          "type": "module",
          "id": "consult-premium",
          "label": "Consultation Premium (menu Tenue, sous Consultation)",
          "default": true
        }
      ]
    }
  ],
  "connect": []
}
